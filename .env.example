# IA conversacional y transcripción alternativa. Nunca exponer en el navegador.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Opcional: voz neural. Azure (recomendado: voces de Ecuador, más barato) o ElevenLabs.
# Sin estas variables se usa la voz del navegador.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# AZURE_SPEECH_VOICE=es-EC-AndreaNeural   (o es-EC-LuisNeural)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_flash_v2_5
# Opcionales. Las cuatro variables completas habilitan pedidos reales compartidos.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generar secretos distintos. STAFF_TOKEN >=24 caracteres, SESSION_SECRET >=32.
STAFF_TOKEN=
SESSION_SECRET=
